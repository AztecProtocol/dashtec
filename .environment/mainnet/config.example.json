{
  "network": {
    "type": "mainnet",
    "chainId": 1
  },
  "database": {
    "url": "postgresql://dashtec:dashtec@postgres-mainnet:5432/dashtec",
    "replicaUrl": "postgresql://dashtec:dashtec@postgres-mainnet:5432/dashtec"
  },
  "redis": {
    "url": "redis://:dashtec@redis-mainnet:6379"
  },
  "rpc": {
    "ethereumUrls": "<<SECRET: injected from MAINNET_ETHEREUM_RPC_URL>>",
    "consensusUrls": "<<SECRET: injected from MAINNET_L1_CONSENSUS_HOST_URLS>>"
  },
  "aztecNode": {
    "url": "http://aztec-node-mainnet:8080",
    "image": "aztecprotocol/aztec:5.2.0@sha256:2dd0b84a5a42285762390e38f82a6ba737bfeba6e39df688af7f050dae81a3b0",
    "network": "mainnet",
    "p2pPort": 40400,
    "syncMode": "snapshot",
    "archiverSkipHistoricalLogsCheck": false,
    "sentinelHistoryLengthInEpochs": 24,
    "maxOldSpaceSizeMb": 4096,
    "memLimit": "8g"
  },
  "contracts": {
    "rollupAddress": "0x0000000000000000000000000000000000000000",
    "governanceAddress": "0x0000000000000000000000000000000000000000",
    "governanceProposerAddress": "0x0000000000000000000000000000000000000000",
    "slashingProposerAddress": "0x0000000000000000000000000000000000000000",
    "gseAddress": "0x0000000000000000000000000000000000000000",
    "stakingRegistryAddress": "0x042dF8f42790d6943F41C25C2132400fd727f452",
    "registryAddress": "0x0000000000000000000000000000000000000000",
    "_comment": "Discovered by `pnpm env:discover mainnet` from the Aztec node (node_getL1ContractAddresses) plus Rollup.getSlasher()/Slasher.PROPOSER(). stakingRegistryAddress is not part of the Aztec core deployment and must be set by hand."
  },
  "collectors": {
    "validatorStats": {
      "pollIntervalMs": 300000,
      "maxPastEpochs": 10,
      "batchSize": 10
    },
    "validatorList": {
      "pollIntervalMs": 60000,
      "batchSize": 50
    },
    "providerList": {
      "apiUrl": "https://api.stake.aztec.network/api",
      "pollIntervalMs": 600000
    },
    "epochIntegrity": {
      "pollIntervalMs": 600000,
      "batchSize": 20,
      "epochsToCheck": 100
    },
    "validatorMigration": {
      "enabled": false,
      "pollIntervalMs": 3600000,
      "batchSize": 50,
      "sourceDbUrl": ""
    },
    "epochAggregates": {
      "pollIntervalMs": 300000,
      "batchSize": 10,
      "epochsToRepair": 50
    }
  },
  "ponder": {
    "port": 42069,
    "maxHealthcheckDuration": 240,
    "startBlock": 0,
    "startBlocks": {},
    "_comment": "startBlock and startBlocks are set by `pnpm env:discover mainnet`. A rollup upgrade redeploys only the rollup and its slashing proposer; the GSE, registry, governance, governance proposer and staking registry keep their addresses, so each is indexed from its own deployment block. Indexing them all from the new rollup discards their earlier events."
  },
  "app": {
    "url": "https://dashtec.xyz",
    "port": 3000,
    "ethereumExplorerUrl": "https://etherscan.io",
    "aztecScanUrl": "https://aztecscan.xyz",
    "rateLimitingEnabled": true,
    "domains": {
      "mainnet": "dashtec.xyz",
      "sepolia": "testnet.dashtec.xyz"
    },
    "auth": {
      "discord": {
        "clientId": "<<set via DISCORD_CLIENT_ID (variable)>>",
        "clientSecret": "<<SECRET: injected from DISCORD_CLIENT_SECRET>>"
      },
      "x": {
        "clientId": "<<set via X_CLIENT_ID (variable)>>",
        "clientSecret": "<<SECRET: injected from X_CLIENT_SECRET>>"
      },
      "sessionPassword": "<<SECRET: injected from MAINNET_SESSION_PASSWORD>>"
    }
  },
  "logging": {
    "level": "info"
  },
  "nodeEnv": "production"
