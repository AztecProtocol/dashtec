// CloudFront Function (viewer-request) attached to the mainnet distribution.
//
// That distribution answers for both ${apex_domain} and ${www_domain}. Requests
// for the apex pass straight through; requests for www get a 301 to the same
// path on the apex. Redirecting rather than serving both matters: APP_URL and
// the registered Discord/X OAuth redirect URIs are apex-only, so a session
// started on www would fail its callback.
//
// Runs on every viewer request to the mainnet distribution, so it is written to
// fall through untouched for anything that is not exactly the www host.
function handler(event) {
    var request = event.request;
    var host = request.headers.host && request.headers.host.value;

    if (host !== '${www_domain}') {
        return request;
    }

    // Rebuild the query string. CloudFront Functions hand it over parsed, and
    // dropping it would break OAuth callbacks and any shareable filtered view.
    var query = '';
    var pairs = [];
    for (var key in request.querystring) {
        var param = request.querystring[key];
        if (param.multiValue) {
            for (var i = 0; i < param.multiValue.length; i++) {
                pairs.push(encodeURIComponent(key) + '=' + encodeURIComponent(param.multiValue[i].value));
            }
        } else if (param.value) {
            pairs.push(encodeURIComponent(key) + '=' + encodeURIComponent(param.value));
        } else {
            pairs.push(encodeURIComponent(key));
        }
    }
    if (pairs.length > 0) {
        query = '?' + pairs.join('&');
    }

    return {
        statusCode: 301,
        statusDescription: 'Moved Permanently',
        headers: {
            'location': { value: 'https://${apex_domain}' + request.uri + query },
            'cache-control': { value: 'max-age=3600' }
        }
    };
}
