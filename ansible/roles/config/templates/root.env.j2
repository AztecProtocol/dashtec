{# Rendered from the per-network config.json (slurped into `dashtec_config` by
   roles/config) plus the secrets in group_vars. Keep every value derived from
   config.json rather than hardcoded, so .environment/<network>/config.json stays
   the single source of truth. #}
# Managed by Ansible (roles/config) — do not edit on the host.
# docker compose auto-loads this file for ${VAR} interpolation. These variables
# have NO defaults in docker-compose.yml and its `environment:` blocks override
# env_file, so without them the web app's node URL, the custom indexer's RPC URL
# and the Aztec nodes' L1 endpoints would all be empty.
{% for network in dashtec_networks %}
{%- set cfg = dashtec_config[network] %}
{%- set suffix = '' if network == 'mainnet' else '_TESTNET' %}
{%- set upper = network | upper %}

# --- {{ network }} ---
# The dashboard and the validator-stats collector both talk to our own Aztec
# node. It answers every node_* method the third-party sentinel proxy used to,
# and SENTINEL_ENABLED in docker-compose.yml is what exposes
# node_getValidatorsStats.
NEXT_SENTINEL_URL{{ suffix }}={{ cfg.aztecNode.url }}
VALIDATOR_STATS_RPC_URL{{ suffix }}={{ cfg.aztecNode.url }}

# Aztec node runtime. ETHEREUM_HOSTS is the L1 execution RPC; the node also
# needs the beacon API to fetch the blobs carrying checkpoint data.
AZTEC_NODE_IMAGE_{{ upper }}={{ cfg.aztecNode.image }}
AZTEC_NODE_ETHEREUM_HOSTS_{{ upper }}={{ network_secrets[network].ethereum_rpc_url }}
AZTEC_NODE_L1_CONSENSUS_HOSTS_{{ upper }}={{ network_secrets[network].l1_consensus_urls }}
AZTEC_NODE_P2P_PORT_{{ upper }}={{ cfg.aztecNode.p2pPort }}
AZTEC_NODE_SYNC_MODE_{{ upper }}={{ cfg.aztecNode.syncMode }}
AZTEC_NODE_SENTINEL_EPOCHS_{{ upper }}={{ cfg.aztecNode.sentinelHistoryLengthInEpochs }}
AZTEC_NODE_HEAP_MB_{{ upper }}={{ cfg.aztecNode.maxOldSpaceSizeMb }}
AZTEC_NODE_MEM_LIMIT_{{ upper }}={{ cfg.aztecNode.memLimit }}
{% endfor %}
