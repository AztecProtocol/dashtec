# Managed by Ansible (roles/config) — do not edit on the host.
# docker compose auto-loads this file for ${VAR} interpolation. These variables
# have NO defaults in docker-compose.yml and its `environment:` blocks override
# env_file, so without them the web app's sentinel URL and the custom indexer's
# RPC URL would be empty. Both are the Aztec node JSON-RPC endpoint
# (SENTINEL_PROXY_URL) — the default node serves all node_* methods there.
{% if 'mainnet' in dashtec_networks %}
NEXT_SENTINEL_URL={{ network_secrets.mainnet.sentinel_proxy_url }}
VALIDATOR_STATS_RPC_URL={{ network_secrets.mainnet.sentinel_proxy_url }}
{% endif %}
{% if 'testnet' in dashtec_networks %}
NEXT_SENTINEL_URL_TESTNET={{ network_secrets.testnet.sentinel_proxy_url }}
VALIDATOR_STATS_RPC_URL_TESTNET={{ network_secrets.testnet.sentinel_proxy_url }}
{% endif %}
