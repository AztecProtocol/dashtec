// Governance and proposer models

enum ProposerVoteType {
  GOVERNANCE_PROPOSER
  SLASHING_PROPOSER
}

model ProposerVote {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())

  vote_type        ProposerVoteType
  signaler_address String           @db.VarChar(42)
  payload_address  String           @db.VarChar(42)
  rollup_address   String           @default("0x0000000000000000000000000000000000000000") @db.VarChar(42)
  round_number     Int
  slot_number      BigInt?
  epoch_number     BigInt?

  block_number     BigInt
  transaction_hash String    @db.VarChar(66)
  log_index        Int
  timestamp        String?   @db.VarChar(30)
  vote_date        DateTime?
  contract_address String?   @db.VarChar(42)

  @@unique([transaction_hash, log_index], name: "unique_vote_transaction_log")
  @@index([vote_type])
  @@index([signaler_address])
  @@index([payload_address])
  @@index([block_number])
  @@index([vote_date])
  @@index([contract_address])
  @@index([rollup_address])
}

