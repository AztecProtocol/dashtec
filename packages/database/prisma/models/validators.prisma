model Validator {
  address              String    @id @db.VarChar(42)
  validator_hex_index  String    @db.VarChar(66)
  withdrawer_address   String?   @db.VarChar(42)
  rollup_address       String    @default("0x0000000000000000000000000000000000000000") @db.VarChar(42)
  withdrawable_balance Decimal?  @db.Decimal(30, 2)
  activation_date      DateTime?
  exit_date            DateTime?
  status               String    @db.VarChar(20)
  stake_balance        Decimal?  @db.Decimal(30, 2)
  first_seen_at        DateTime  @default(now())
  last_updated_at      DateTime  @updatedAt
  x_handle             String?   @db.VarChar(50)
  x_user_id            String?   @db.VarChar(50)
  x_image_url          String?   @db.VarChar(500)
  discordId            String?   @db.VarChar(50)
  discordUsername      String?   @db.VarChar(100)
  discordAvatar        String?   @db.VarChar(500)
  name                 String?   @db.VarChar(100)

  // Relations
  attestations     ValidatorAttestation[]
  epochPerformance ValidatorEpochPerformance[]

  @@index([status])
  @@index([address])
  @@index([validator_hex_index])
}

model ValidatorQueue {
  id                 String   @id @default(uuid()) @db.Uuid
  attester_address   String   @db.VarChar(42)
  withdrawer_address String   @db.VarChar(42)
  rollup_address     String   @default("0x0000000000000000000000000000000000000000") @db.VarChar(42)
  queued_at          DateTime @default(now())
  block_number       BigInt
  transaction_hash   String   @db.VarChar(66)
  log_index          Int

  @@unique([transaction_hash, log_index], name: "unique_validator_queue_transaction_log")
  @@index([attester_address])
  @@index([queued_at])
  @@index([block_number])
  @@index([rollup_address])
}

model ValidatorAttestation {
  id                String   @id @default(uuid()) @db.Uuid
  slot_number       BigInt
  epoch_number      BigInt
  validator_address String   @db.VarChar(42)
  rollup_address    String   @default("0x0000000000000000000000000000000000000000") @db.VarChar(42)
  committee_index   Int?
  timestamp         DateTime @default(now())
  status            String   @db.VarChar(20)

  // Relations
  epoch     Epoch     @relation(fields: [epoch_number, rollup_address], references: [epoch_number, rollup_address])
  validator Validator @relation(fields: [validator_address], references: [address])

  @@unique([slot_number, validator_address, rollup_address], name: "composite_attestation_key")
  @@index([slot_number])
  @@index([epoch_number])
  @@index([validator_address])
  @@index([rollup_address])
}

model ValidatorEpochPerformance {
  id                      String   @id @default(uuid()) @db.Uuid
  epoch_number            BigInt
  validator_address       String   @db.VarChar(42)
  rollup_address          String   @default("0x0000000000000000000000000000000000000000") @db.VarChar(42)
  attestations_successful Int      @default(0)
  attestations_missed     Int      @default(0)
  checkpoints_proposed    Int      @default(0)
  checkpoints_mined       Int      @default(0)
  checkpoints_missed      Int      @default(0)
  blocks_missed           Int      @default(0)
  calculated_at           DateTime @default(now())

  // Relations
  epoch     Epoch     @relation(fields: [epoch_number, rollup_address], references: [epoch_number, rollup_address])
  validator Validator @relation(fields: [validator_address], references: [address])

  @@unique([epoch_number, validator_address, rollup_address], name: "unique_validator_epoch_performance")
  @@index([epoch_number])
  @@index([validator_address])
  @@index([rollup_address])
}

model MaterializedValidatorDeposit {
  id                 String @id
  attester_address   String @db.VarChar(42)
  withdrawer_address String @db.VarChar(42)
  rollup_address     String @db.VarChar(42)
  amount             String @db.VarChar(30)
  block_number       BigInt
  log_index          Int
  transaction_hash   String @db.Char(66)
  timestamp          BigInt?
  extra              Json?

  @@unique([transaction_hash, log_index], name: "unique_mat_deposit_tx_log")
  @@index([attester_address])
  @@index([rollup_address])
  @@index([block_number])
}

