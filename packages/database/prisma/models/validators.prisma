model MaterializedValidatorStakeHistory {
  id               String @id
  attester_address String @db.VarChar(42)
  rollup_address   String @db.VarChar(42)
  event_type       String @db.VarChar(20) // 'deposit' | 'gse_deposit' | 'slashed' | 'withdraw'
  amount           String @db.VarChar(30)
  block_number     BigInt
  log_index        Int
  transaction_hash String @db.Char(66)
  timestamp        BigInt?

  @@unique([transaction_hash, log_index], name: "unique_mat_stake_history_tx_log")
  @@index([attester_address])
  @@index([rollup_address])
  @@index([block_number])
  @@index([event_type])
}

model ValidatorRollup {
  id                  String   @id @default(uuid()) @db.Uuid
  address             String   @db.VarChar(42)
  rollup_address      String   @db.VarChar(42)
  migration_status    String   @default("active") @db.VarChar(20)
  deposit_type        String   @db.VarChar(20)
  block_number        BigInt
  transaction_hash    String   @db.VarChar(66)
  log_index           Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([address, rollup_address], name: "unique_validator_rollup")
  @@unique([transaction_hash, log_index], name: "unique_validator_rollup_tx_log")
  @@index([rollup_address])
  @@index([address])
  @@index([migration_status])
}

model ValidatorMigration {
  id                  String   @id @default(uuid()) @db.Uuid
  validator_address   String   @unique @db.VarChar(42)
  found_in_source     Boolean  @default(false)
  had_social_data     Boolean  @default(false)
  was_updated         Boolean  @default(false)
  already_had_social  Boolean  @default(false)
  updated_fields      Json?
  migration_timestamp DateTime @default(now())
  processed_by        String   @default("validator-migration-collector") @db.VarChar(100)

  @@index([validator_address])
  @@index([migration_timestamp])
  @@index([found_in_source])
  @@index([was_updated])
}
