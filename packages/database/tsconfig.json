{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "ES2021",
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "incremental": false
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "generated"
  ]
}