{
  "name": "@dashtec/materializer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests --forceExit",
    "test:unit": "jest --testPathPatterns=unit --forceExit",
    "test:integration": "jest --testPathPatterns=integration --forceExit --testTimeout=60000",
    "test:coverage": "jest --coverage --forceExit",
    "typecheck": "tsc --noEmit",
    "integrity-check": "tsx src/scripts/integrity-check.ts",
    "integrity-fix": "tsx src/scripts/integrity-check.ts --fix",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@dashtec/database": "workspace:*",
    "@dashtec/indexer-ponder": "workspace:*",
    "@dashtec/shared-utils": "workspace:*",
    "@ponder/client": "^0.16.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "pg": "^8.13.1",
    "viem": "^2.22.17",
    "ponder": "^0.15.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "@testcontainers/postgresql": "^10.18.0",
    "jest": "^30.0.0",
    "testcontainers": "^10.18.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}