{
  "name": "@dashtec/indexer-custom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "test": "jest --config jest.config.cjs --forceExit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "dev:validator-stats": "tsx src/collectors/ValidatorStatsCollector.ts",
    "dev:validator-list": "tsx src/collectors/ValidatorListCollector.ts",
    "dev:epoch-integrity": "tsx src/collectors/EpochIntegrityCollector.ts",
    "dev:epoch-aggregates": "tsx src/collectors/EpochAggregatesCollector.ts",
    "dev:validator-migration": "tsx src/collectors/ValidatorMigrationCollector.ts",
    "dev:provider-list": "tsx src/collectors/ProviderListCollector.ts",
    "start:validator-stats": "node dist/collectors/ValidatorStatsCollector.js",
    "start:validator-list": "node dist/collectors/ValidatorListCollector.js",
    "start:epoch-integrity": "node dist/collectors/EpochIntegrityCollector.js",
    "start:epoch-aggregates": "node dist/collectors/EpochAggregatesCollector.js",
    "start:validator-migration": "node dist/collectors/ValidatorMigrationCollector.js",
    "start:provider-list": "node dist/collectors/ProviderListCollector.js",
    "import:validator-stats": "tsx src/scripts/import-validator-stats.ts",
    "sentinel:check": "tsx src/scripts/check-sentinel-integrity.ts"
  },
  "dependencies": {
    "@dashtec/aztec-rpc-sdk": "workspace:*",
    "@dashtec/database": "workspace:*",
    "@dashtec/shared-types": "workspace:*",
    "@dashtec/shared-utils": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/extension-read-replicas": "^0.4.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "viem": "^2.31.6",
    "winston": "^3.17.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@swc/core": "^1.15.8",
    "@swc/jest": "^0.2.38",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}